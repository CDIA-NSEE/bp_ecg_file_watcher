# bp_ecg_file_watcher — environment variable reference
# Copy this file to .env and fill in real values. Never commit .env.

# Required: directory containing .zip files to process
INPUT_DIRECTORY=/data/incoming

# Required: directory where .pdf.zst output files are written
# skip.log is also written here
OUTPUT_DIRECTORY=/data/output

# Deduplication — Redis connection URL
REDIS_URL=redis://localhost:6379

# Dask scheduler address (optional)
# Leave unset for LocalCluster (development) or SLURM auto-detection (HPC).
# Set to tcp://dask-scheduler:8786 when using docker-compose.
DASK_SCHEDULER=

# Dask cluster sizing (used in SLURM mode — ignored for LocalCluster)
N_WORKERS=24
CORES_PER_WORKER=8
MEM_PER_WORKER_GB=16

# Processing parameters (optional)
RASTERIZATION_DPI=300
IMAGE_MAX_SIDE_PX=1200
ZSTD_LEVEL=9

# Observability (optional)
LOG_LEVEL=INFO
ENVIRONMENT=dev    # "dev" = coloured console logs, anything else = JSON

