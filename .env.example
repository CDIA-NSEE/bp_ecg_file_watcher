# bp_ecg_file_watcher — environment variable reference
# Copy this file to .env and fill in real values. Never commit .env.

# Directory to watch for incoming ZIP files
WATCH_DIRECTORY=/data/incoming

# MINIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Bucket names (defaults shown — override per environment)
BUCKET_IMAGES=bp-ecg-dev-images
BUCKET_INTAKE=bp-ecg-dev-intake
BUCKET_REJECTED=bp-ecg-dev-rejected

# Worker pool
MAX_WORKERS=4
QUEUE_MAXSIZE=50

# Processing parameters
RASTERIZATION_DPI=300
IMAGE_MAX_SIDE_PX=1200
ZSTD_LEVEL=9

# File stability check
DEBOUNCE_POLLS=3
DEBOUNCE_INTERVAL_MS=200

# Prometheus metrics server port
METRICS_PORT=8000

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=dev
